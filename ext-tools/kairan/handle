#!/usr/bin/env bash
set -euo pipefail

# handle: runs once per message sent to a kairan member. agmsg passes the
# message as one JSON object on stdin; what is printed here is the reply.
#
#   post <text>   put up a notice; replies with its number
#   list          open notices and who has seen each
#   seen <n>      stamp notice <n> as seen by the sender
#   close <n>     take notice <n> down and archive it, with its stamps (only
#                 whoever posted it)
#   archive       closed notices, newest first (the latest 10)
#
# Every reply and every command word lives in messages/<lang>, not here.
# messages/en and messages/ja name their own words for the same five commands
# (messages/ja has the Japanese ones), the reply comes from the file whose word
# was used, and anything unknown gets the English usage line. To add a
# language, copy messages/en to messages/<lang> and translate each value,
# command words included; nothing in this file changes.
#
# Notices live in one JSON file next to the member's config
# (<config>.kairan.json), so each member in each team has its own board:
# {"next": <n>, "items": [open...], "archived": [closed...]}. A board written
# before archiving existed has no "archived" key; it is read as empty. Numbers
# come from "next" and are never reused.

command -v jq >/dev/null 2>&1 || { echo "jq is not installed" >&2; exit 1; }

msg="$(cat)"
from="$(printf '%s' "$msg" | jq -r '.from // ""')"
body="$(printf '%s' "$msg" | jq -r '.body // ""')"
config_path="$(printf '%s' "$msg" | jq -r '.config_path // ""')"
[ -n "$from" ] || { echo "message has no sender" >&2; exit 1; }
[ -n "$config_path" ] || { echo "message has no config_path" >&2; exit 1; }

board="${config_path%.conf}.kairan.json"
lock="$board.lock"

# Messages are handled in parallel, so changes to the board are serialized
# with a lock directory. A lock older than a minute is left over from a
# crashed run and is taken over.
take_lock() {
  local i
  for i in $(seq 1 50); do
    mkdir "$lock" 2>/dev/null && return 0
    if [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
      rmdir "$lock" 2>/dev/null || true
      continue
    fi
    sleep 0.1
  done
  echo "the board is busy; try again" >&2
  exit 1
}
take_lock
trap 'rmdir "$lock" 2>/dev/null || true' EXIT

[ -f "$board" ] || printf '{"next":1,"items":[]}\n' > "$board"

save() {  # <new json>
  local tmp
  tmp="$(mktemp "$board.XXXXXX")"
  printf '%s\n' "$1" > "$tmp"
  mv "$tmp" "$board"
}

messages="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/messages"

# Values filled into a reply are inserted as they are; bash 5.2 would
# otherwise read '&' in them as "the matched text".
shopt -u patsub_replacement 2>/dev/null || true

# lookup <file> <key>: the text after "<key>=" in a messages file.
lookup() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "$2="*) printf '%s' "${line#*=}"; return 0 ;; esac
  done < "$1"
}

# text <key> [<name> <value>]...: reply <key> in $lang, each {name} filled in.
text() {
  local s
  s="$(lookup "$messages/$lang" "$1")"
  shift
  while [ $# -ge 2 ]; do
    s="${s//\{$1\}/$2}"
    shift 2
  done
  printf '%s' "$s"
}

say() { printf '%s\n' "$(text "$@")"; }

# First word is the command; the rest is its argument. A full-width space
# (U+3000, written as its UTF-8 bytes) counts as a space; leading and trailing
# whitespace is dropped.
body="${body//$(printf '\343\200\200')/ }"
trimmed="$(printf '%s' "$body" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
cmd="${trimmed%%[[:space:]]*}"
arg="$(printf '%s' "${trimmed#"$cmd"}" | sed -e 's/^[[:space:]]*//')"
lc_cmd="$(printf '%s' "$cmd" | tr '[:upper:]' '[:lower:]')"

# The first messages file (en sorts first) whose word matches sets the reply
# language and the command.
lang=en
op=""
for file in "$messages"/*; do
  for c in post list seen close archive; do
    if [ "$lc_cmd" = "$(lookup "$file" "cmd.$c")" ]; then
      lang="${file##*/}"
      op="$c"
      break 2
    fi
  done
done

# A notice number, or a usage reply.
want_number() {
  case "$arg" in
    ''|*[!0-9]*) say need_number cmd "$cmd"; exit 0 ;;
  esac
}

# One notice per entry: its number and text, then who posted it and who has
# seen it, plus when it closed for archived ones.
show() {  # <jq path> <empty-seen key> [closed]
  jq -r --arg by "$(text posted_by)" --arg sb "$(text seen_by)" \
    --arg none "$(text "$2")" --arg cl "$(text closed_at)" --arg withclosed "${3:-}" \
    "$1"' | "[\(.id)] \(.body)\n    \($by): \(.from)  \($sb): \(if (.seen | length) == 0 then $none else (.seen | join(", ")) end)\(if $withclosed == "" then "" else "  \($cl): \(.closed_at // "-")" end)"' "$board"
}

case "$op" in
  post)
    if [ -z "$arg" ]; then
      say need_text
      exit 0
    fi
    now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    new="$(jq --arg f "$from" --arg b "$arg" --arg t "$now" \
      '.items += [{id: .next, from: $f, body: $b, at: $t, seen: []}] | .next += 1' "$board")"
    save "$new"
    n="$(printf '%s' "$new" | jq '.next - 1')"
    say posted n "$n"
    ;;
  list)
    if [ "$(jq '.items | length' "$board")" -eq 0 ]; then
      say list_empty
      exit 0
    fi
    show '.items[]' nobody_yet
    ;;
  seen)
    want_number
    if [ "$(jq --argjson n "$arg" '[.items[] | select(.id == $n)] | length' "$board")" -eq 0 ]; then
      say no_such n "$arg"
      exit 0
    fi
    save "$(jq --argjson n "$arg" --arg f "$from" \
      '.items |= map(if .id == $n and ((.seen | index($f)) == null) then .seen += [$f] else . end)' "$board")"
    say stamped n "$arg" from "$from"
    ;;
  close)
    want_number
    owner="$(jq -r --argjson n "$arg" '.items[] | select(.id == $n) | .from' "$board")"
    if [ -z "$owner" ]; then
      say no_such n "$arg"
      exit 0
    fi
    if [ "$owner" != "$from" ]; then
      say not_owner n "$arg" owner "$owner"
      exit 0
    fi
    seen="$(jq -r --argjson n "$arg" '.items[] | select(.id == $n) | if (.seen | length) == 0 then "" else (.seen | join(", ")) end' "$board")"
    now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    save "$(jq --argjson n "$arg" --arg t "$now" \
      '.archived = ((.archived // []) + [.items[] | select(.id == $n) | .closed_at = $t]) | .items |= map(select(.id != $n))' "$board")"
    say closed n "$arg" seen "${seen:-$(text nobody)}"
    ;;
  archive)
    total="$(jq '(.archived // []) | length' "$board")"
    if [ "$total" -eq 0 ]; then
      say archive_empty
      exit 0
    fi
    # Newest first: notices are appended as they close.
    show '(.archived // []) | reverse | .[0:10][]' nobody closed
    if [ "$total" -gt 10 ]; then
      say archive_more total "$total"
    fi
    ;;
  *)
    say usage
    ;;
esac
